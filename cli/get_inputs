#!/bin/bash

function get_inputs {
	printf "\n${BLUE}Domain prefix: ${NC}"
	read DOMAIN
	if [ ! $DOMAIN ]; then
		printf "*** Domain prefix is required. \nExit\n"
		exit
	fi

	PHP_VERSION=7.4
	printf "\n${BLUE}PHP version ${GRAY}[Default 7.4]:${NC}\n "
	read php_version
	if [ $php_version ]; then
		PHP_VERSION=$php_version
	fi

	NODEJS_VERSION=20.x
	printf "\n${BLUE}NodeJS version ${GRAY}[Default 20.x]:${NC}\n "
	read nodejs_version
	if [ $nodejs_version ]; then
		NODEJS_VERSION=$nodejs_version
	fi
}
