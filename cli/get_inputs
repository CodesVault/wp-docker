#!/bin/bash

function get_inputs {
	printf "\n${BLUE}Domain prefix: ${NC}"
	read DOMAIN
	if [ ! $DOMAIN ]; then
		printf "*** Domain prefix is required. \nExit\n"
		exit
	fi

	PHP_VERSION=8.1
	while true; do
		printf "\n${BLUE}PHP version ${GRAY}[Default 8.1]: ${NC}"
		read php_version
		if [ $php_version ]; then
			# Compare version with 8.1
			if awk "BEGIN {exit !($php_version < 8.1)}"; then
				printf "${RED}*** Minimum version required: 8.1${NC}\n"
				continue
			fi
			PHP_VERSION=$php_version
		fi
		break
	done

	NODEJS_VERSION=22.x
	printf "\n${BLUE}NodeJS version ${GRAY}[Default 22.x]: ${NC}"
	read nodejs_version
	if [ $nodejs_version ]; then
		NODEJS_VERSION=$nodejs_version
	fi
}
