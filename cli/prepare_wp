#!/bin/bash

source $(dirname "$0")/cli/ui

check_os() {
	OS="`uname`"
	Extension='.zip'

	if [ $OS == "Darwin" ]; then
		Extension=".tar.gz"
	fi
}

function prepare_wp {
	echo 
	printf "${BLUE}Want to download WordPress also? ${GRAY}(y/N): ${NC}"
	read Download_WP
	if [ $Download_WP == "N" ]; then
		exit
	fi

	check_os

	wp_version=latest
	printf "\n${BLUE}WordPress Version ${GRAY}[Default: latest]: ${NC}"
	read WP_Version
	if [ $WP_Version ]; then
		wp_version=$WP_Version
	fi
	if [ $wp_version != "latest" ]; then
		wp_version="wordpress-$WP_Version"
	fi

	echo 
	printLn "Downloading WordPress $wp_version ..."
	curl -sS -o wp$Extension https://wordpress.org/$wp_version$Extension

	if [ `uname` != 'Darwin' ]; then
		printf "${GREY}Changing folder mod, may require sudo password..${NC}\n"
		sudo chown $User:$User wp$Extension
	fi
	sudo chmod 777 wp$Extension

	printLn "Unzipping..."
	if [ `uname` != 'Darwin' ]; then
		unzip -q wp$Extension
	fi
	if [ `uname` == 'Darwin' ]; then
		tar -xf wp$Extension
	fi

	echo 
	if [ `uname` != 'Darwin' ]; then
		sudo chown -R $User:$User wordpress
	fi
	sudo chmod -R 777 wordpress

	rm -rf wp$Extension
	echo "Done."
}
