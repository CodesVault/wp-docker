#!/bin/bash

DOMAIN=$1
PORT=$2

function congrats {
	i=0
	while IFS= read -r line; 
	do
		if [ $i == 3 ]; then
			Port=$line
		fi
		(( i++ ))
	done <.env

	echo "Awesome! you did it..."
	echo
	printf "${GREEN}%s%s\n" "http://localhost:" "$PORT";
	printf "%s%s${NC}\n" "http://$DOMAIN.test:" "$PORT";
	echo
	printf "Author: ${BLUE}Keramot UL Islam <https://abmsourav.com>${NC}\n";
	printf "${GRAY}Developed by CodesVault <https://github.com/CodesVault>${NC}";
	echo
	echo
}
